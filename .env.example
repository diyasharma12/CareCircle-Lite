# Optional: leave unset to use the built-in template-based assistant answer
# (no API key, no network call, works offline). Get a free key at
# https://console.groq.com if you want the assistant's answer phrased by an
# LLM instead of the template -- the streaming works identically either way.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
